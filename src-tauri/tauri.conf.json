{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ToknIsland",
  "version": "0.1.0-alpha.0",
  "identifier": "com.toknisland.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ToknIsland",
        "width": 1280,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
